# Cloud case assistant and automatic FDI identification. Local mesh detection works without credentials.
# Copy this file to .env.local, set the key there, then restart dev or preview.
# Server only: never prefix a secret with VITE_.
ANTHROPIC_API_KEY=
# Initial chat model; the in-app selector can override it per question.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional rendered-scan identification via Vercel AI SDK (same server-only key).
# Initial identification model; the in-app selector can override it per request.
ANTHROPIC_TOOTH_MODEL=claude-opus-5-5
# Initial case assessment model; the in-app selector can override it per request.
ANTHROPIC_PLANNING_MODEL=claude-opus-5-5
# Planning sends only the explicitly previewed rendered views and anonymized metadata.
